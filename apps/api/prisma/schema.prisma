generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String?
  roleId    String?  @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  role Role? @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]

  @@map("roles")
}

// ─────────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────────

model Group {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  displayOrder Int?      @map("display_order")
  accounts     Account[]

  @@map("groups")
}

// ─────────────────────────────────────────────
// ACCOUNTS (Client + Broker + Account Master)
// ─────────────────────────────────────────────

model Account {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  groupId             Int      @map("group_id")
  address             String?
  mobileNumber        String?  @map("mobile_number")
  officeNumber        String?  @map("office_number")
  whatsappNumber      String?  @map("whatsapp_number")
  email               String?
  contactPersonName   String?  @map("contact_person_name")
  contactPersonMobile String?  @map("contact_person_mobile")
  contactPersonEmail  String?  @map("contact_person_email")
  referenceName       String?  @map("reference_name")
  referenceMobile     String?  @map("reference_mobile")
  referenceEmail      String?  @map("reference_email")
  bankName            String?  @map("bank_name")
  bankBranch          String?  @map("bank_branch")
  ifscCode            String?  @map("ifsc_code")
  micrCode            String?  @map("micr_code")
  bankAccountNumber   String?  @map("bank_account_number")
  upiId               String?  @map("upi_id")
  isActive            Boolean  @default(true) @map("is_active")
  isDirectClient      Boolean  @default(true) @map("is_direct_client")
  dealerCode          String?  @map("dealer_code")
  openingBalance      Float    @default(0) @map("opening_balance")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  group         Group         @relation(fields: [groupId], references: [id])
  brokerages    Brokerage[]
  trades        Trade[]       @relation("AccountTrades")
  brokerTrades  Trade[]       @relation("BrokerTrades")
  voucherLines  VoucherLine[]
  ledgerEntries Ledger[]

  @@index([name])
  @@index([groupId])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// SCRIPTS
// ─────────────────────────────────────────────

model Script {
  id         String    @id @default(uuid())
  shortName  String    @map("short_name")
  fullName   String    @map("full_name")
  isin       String?   @map("isin")
  lotSize    Int       @map("lot_size")
  exchangeId String?   @map("exchange_id")
  currencyId String?   @map("currency_id")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt      @map("updated_at")

  exchange     Exchange?    @relation(fields: [exchangeId], references: [id])
  currency     Currency?    @relation(fields: [currencyId], references: [id])
  brokerages   Brokerage[]
  trades       Trade[]
  closingRates ClosingRate[]

  @@index([fullName])
  @@map("scripts")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AppliesTo {
  CLIENT
  BROKER
}

enum BrokerageType {
  AMOUNT
  PERCENT
}

enum BrokerageScope {
  DEFAULT
  SCRIPT
}

// ─────────────────────────────────────────────
// EXCHANGES
// ─────────────────────────────────────────────

model Exchange {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  brokerages   Brokerage[]
  trades       Trade[]
  closingRates ClosingRate[]
  scripts      Script[]

  @@map("exchanges")
}

// ─────────────────────────────────────────────
// CURRENCIES
// ─────────────────────────────────────────────

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique              // e.g. "USD", "AED", "INR"
  name      String?                        // e.g. "US Dollar"
  symbol    String?                        // e.g. "$", "₹", "د.إ"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  scripts   Script[]

  @@map("currencies")
}


// ─────────────────────────────────────────────
// TRADES
// ─────────────────────────────────────────────

model Trade {
  id              String   @id @default(uuid())
  tradeNumber     String   @map("trade_number")
  tradeDate       DateTime @map("trade_date")
  tradeTime       String?  @map("trade_time")
  accountId       String   @map("account_id")
  scriptId        String   @map("script_id")
  exchangeId      String   @map("exchange_id")
  transactionType String   @map("transaction_type") // BUY or SELL
  quantity        Float    @map("quantity")
  rate            Float    @map("rate")
  remarks         String?  @map("remarks")
  source          String   @map("source") // MANUAL or IMPORT
  terminal        String?  @map("terminal")
  expiry          String?  @map("expiry")
  orderId         String?  @map("order_id")
  exchangeTime    String?  @map("exchange_time")
  uniqueTradeId   String?  @map("unique_trade_id")
  orderTime       String?  @map("order_time")

  // Additional fields for Dubai FnO & trade imports
  dealerCode      String?  @map("dealer_code")
  currencyCode    String?  @map("currency_code")
  securityName    String?  @map("security_name")
  delMonth        String?  @map("del_month")
  marketLot       Float?   @map("market_lot")
  callPut         String?  @map("call_put")
  strikePrice     Float?   @map("strike_price")
  bloombergCode   String?  @map("bloomberg_code")
  mktValue        Float?   @map("mkt_value")
  clnCommission   Float?   @map("cln_commission")
  clnExCharges    Float?   @map("cln_ex_charges")
  clnCharges1     Float?   @map("cln_charges1")
  clnCharges2     Float?   @map("cln_charges2")
  vat             Float?   @map("vat")

  // Trade classification
  tradeType       String   @default("REGULAR") @map("trade_type") // REGULAR, CARRY_FORWARD, BACK_FORWARD, SETTLEMENT
  settlementId    String?  @map("settlement_id")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  // Calculations
  brokerId        String?  @map("broker_id")
  clientRate      Float?   @map("client_rate")
  brokerRate      Float?   @map("broker_rate")
  clientBrokerage Float?   @map("client_brokerage")
  brokerBrokerage Float?   @map("broker_brokerage")
  profitTotal     Float?   @map("profit_total")

  account    Account     @relation("AccountTrades", fields: [accountId],  references: [id], onDelete: Cascade)
  broker     Account?    @relation("BrokerTrades",  fields: [brokerId],   references: [id], onDelete: Cascade)
  script     Script      @relation(fields: [scriptId],   references: [id], onDelete: Cascade)
  exchange   Exchange    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@index([accountId])
  @@index([brokerId])
  @@index([scriptId])
  @@index([exchangeId])
  @@index([settlementId])
  @@map("trades")
}

// ─────────────────────────────────────────────
// BROKERAGES
// ─────────────────────────────────────────────

model Brokerage {
  id          String         @id @default(uuid())
  accountId   String         @map("account_id")
  exchangeId  String         @map("exchange_id")
  appliesTo   AppliesTo      @map("applies_to")
  type        BrokerageType
  scope       BrokerageScope @default(DEFAULT)
  scriptId    String?        @map("script_id")

  // Amount-based fields
  baseAmount  Float?         @map("base_amount")
  flatFee     Float?         @map("flat_fee")

  // Trading percentage fields
  tradingBuyPct   Float?     @map("trading_buy_pct")
  tradingSellPct  Float?     @map("trading_sell_pct")
  tradingMinFee   Float?     @map("trading_min_fee")

  // Delivery percentage fields
  deliveryBuyPct  Float?     @map("delivery_buy_pct")
  deliverySellPct Float?     @map("delivery_sell_pct")
  deliveryMinFee  Float?     @map("delivery_min_fee")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  account  Account  @relation(fields: [accountId],  references: [id])
  exchange Exchange @relation(fields: [exchangeId], references: [id])
  script   Script?  @relation(fields: [scriptId],   references: [id])

  @@unique([accountId, exchangeId, appliesTo, scope, scriptId], name: "uq_brokerage_rule")
  @@index([accountId])
  @@index([exchangeId])
  @@map("brokerages")
}

// ─────────────────────────────────────────────
// CLOSING RATES
// ─────────────────────────────────────────────

model ClosingRate {
  id            String   @id @default(uuid())
  exchangeId    String   @map("exchange_id")
  scriptId      String?  @map("script_id")
  securityName  String   @map("security_name")
  rateDate      DateTime @map("rate_date")
  rate          Float    @map("rate")

  expiry        String?  @map("expiry")
  delMonth      String?  @map("del_month")
  callPut       String?  @map("call_put")
  strikePrice   Float?   @map("strike_price")
  bloombergCode String?  @map("bloomberg_code")
  currencyCode  String?  @map("currency_code")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  script   Script?  @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, securityName, rateDate])
  @@index([exchangeId])
  @@index([scriptId])
  @@index([securityName])
  @@map("closing_rates")
}

// ─────────────────────────────────────────────
// SETTLEMENTS
// ─────────────────────────────────────────────

model Settlement {
  id        String   @id @default(uuid())
  name      String                          // e.g. "Settlement 1"
  fromDate  DateTime @map("from_date")
  toDate    DateTime @map("to_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  trades Trade[]

  @@map("settlements")
}

// ─────────────────────────────────────────────
// LEDGER ENTRIES
// ─────────────────────────────────────────────

model Ledger {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  date        DateTime @map("date")
  amount      Float    @map("amount")
  entryType   String   @map("entry_type")       // SETTLEMENT, VOUCHER
  description String?  @map("description")
  referenceId String?  @map("reference_id")     // settlementId or voucherId
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────
// VOUCHERS
// ─────────────────────────────────────────────

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
}

model Voucher {
  id            String        @id @default(uuid())
  voucherNumber String?       @map("voucher_number")
  date          DateTime      @map("date")
  type          VoucherType   @map("type")
  remarks       String?       @map("remarks")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt      @map("updated_at")
  
  lines         VoucherLine[]

  @@map("vouchers")
}

model VoucherLine {
  id        String   @id @default(uuid())
  voucherId String   @map("voucher_id")
  accountId String   @map("account_id")
  amount    Float    @map("amount")

  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([accountId])
  @@map("voucher_lines")
}


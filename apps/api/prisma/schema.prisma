generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String?
  roleId    String?  @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  role Role? @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]

  @@map("roles")
}

// ─────────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────────

model Group {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  displayOrder Int?      @map("display_order")
  accounts     Account[]

  @@map("groups")
}

// ─────────────────────────────────────────────
// ACCOUNTS (Client + Broker + Ledger)
// ─────────────────────────────────────────────

model Account {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  groupId             Int      @map("group_id")
  address             String?
  mobileNumber        String?  @map("mobile_number")
  officeNumber        String?  @map("office_number")
  whatsappNumber      String?  @map("whatsapp_number")
  email               String?
  contactPersonName   String?  @map("contact_person_name")
  contactPersonMobile String?  @map("contact_person_mobile")
  contactPersonEmail  String?  @map("contact_person_email")
  referenceName       String?  @map("reference_name")
  referenceMobile     String?  @map("reference_mobile")
  referenceEmail      String?  @map("reference_email")
  bankName            String?  @map("bank_name")
  bankBranch          String?  @map("bank_branch")
  ifscCode            String?  @map("ifsc_code")
  micrCode            String?  @map("micr_code")
  bankAccountNumber   String?  @map("bank_account_number")
  upiId               String?  @map("upi_id")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  group      Group       @relation(fields: [groupId], references: [id])
  brokerages Brokerage[]
  trades     Trade[]

  @@index([name])
  @@index([groupId])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// SCRIPTS
// ─────────────────────────────────────────────

model Script {
  id        String   @id @default(uuid())
  shortName String   @map("short_name")
  fullName  String   @map("full_name")
  isin      String?  @map("isin")
  lotSize   Int      @map("lot_size")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  brokerages             Brokerage[]
  scriptExchangeMappings ScriptExchangeMapping[]
  trades                 Trade[]

  @@index([fullName])
  @@map("scripts")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AppliesTo {
  CLIENT
  BROKER
}

enum BrokerageType {
  AMOUNT
  PERCENT
}

enum BrokerageScope {
  DEFAULT
  SCRIPT
}

// ─────────────────────────────────────────────
// EXCHANGES
// ─────────────────────────────────────────────

model Exchange {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  brokerages             Brokerage[]
  scriptExchangeMappings ScriptExchangeMapping[]
  trades                 Trade[]

  @@map("exchanges")
}

// ─────────────────────────────────────────────
// SCRIPT EXCHANGE MAPPING
// ─────────────────────────────────────────────

model ScriptExchangeMapping {
  id                 String   @id @default(uuid())
  scriptId           String   @map("script_id")
  exchangeId         String   @map("exchange_id")
  exchangeScriptCode String   @map("exchange_script_code")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt      @map("updated_at")

  script   Script   @relation(fields: [scriptId],   references: [id], onDelete: Cascade)
  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@unique([scriptId, exchangeId])
  @@map("script_exchange_mappings")
}

// ─────────────────────────────────────────────
// TRADES
// ─────────────────────────────────────────────

model Trade {
  id              String   @id @default(uuid())
  tradeNumber     String   @map("trade_number")
  tradeDate       DateTime @map("trade_date")
  tradeTime       String?  @map("trade_time")
  accountId       String   @map("account_id")
  scriptId        String   @map("script_id")
  exchangeId      String   @map("exchange_id")
  transactionType String   @map("transaction_type") // BUY or SELL
  quantity        Float    @map("quantity")
  rate            Float    @map("rate")
  remarks         String?  @map("remarks")
  source          String   @map("source") // MANUAL or IMPORT
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  account  Account  @relation(fields: [accountId],  references: [id], onDelete: Cascade)
  script   Script   @relation(fields: [scriptId],   references: [id], onDelete: Cascade)
  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([scriptId])
  @@index([exchangeId])
  @@map("trades")
}

// ─────────────────────────────────────────────
// BROKERAGES
// ─────────────────────────────────────────────

model Brokerage {
  id          String         @id @default(uuid())
  accountId   String         @map("account_id")
  exchangeId  String         @map("exchange_id")
  appliesTo   AppliesTo      @map("applies_to")
  type        BrokerageType
  scope       BrokerageScope @default(DEFAULT)
  scriptId    String?        @map("script_id")

  // Amount-based fields
  baseAmount  Float?         @map("base_amount")
  flatFee     Float?         @map("flat_fee")

  // Trading percentage fields
  tradingBuyPct   Float?     @map("trading_buy_pct")
  tradingSellPct  Float?     @map("trading_sell_pct")
  tradingMinFee   Float?     @map("trading_min_fee")

  // Delivery percentage fields
  deliveryBuyPct  Float?     @map("delivery_buy_pct")
  deliverySellPct Float?     @map("delivery_sell_pct")
  deliveryMinFee  Float?     @map("delivery_min_fee")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  account  Account  @relation(fields: [accountId],  references: [id])
  exchange Exchange @relation(fields: [exchangeId], references: [id])
  script   Script?  @relation(fields: [scriptId],   references: [id])

  @@unique([accountId, exchangeId, appliesTo, scope, scriptId], name: "uq_brokerage_rule")
  @@index([accountId])
  @@index([exchangeId])
  @@map("brokerages")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String?
  roleId    String?  @map("role_id")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  role Role? @relation(fields: [roleId], references: [id])

  @@index([isDeleted])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")

  isDeleted   Boolean          @default(false) @map("is_deleted")
  deletedAt   DateTime?        @map("deleted_at")

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt      @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@index([isDeleted])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  feature     String           @map("feature")
  action      String           @map("action")
  name        String           @map("name")
  description String?          @map("description")
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@unique([feature, action], name: "uq_feature_action")
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "uq_role_permission")
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────────

model Group {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  displayOrder Int?      @map("display_order")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  accounts     Account[]

  @@index([isDeleted])
  @@map("groups")
}

// ─────────────────────────────────────────────
// ACCOUNTS (Client + Broker + Account Master)
// ─────────────────────────────────────────────

model Account {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  groupId             Int      @map("group_id")
  address             String?
  mobileNumber        String?  @map("mobile_number")
  officeNumber        String?  @map("office_number")
  whatsappNumber      String?  @map("whatsapp_number")
  email               String?
  contactPersonName   String?  @map("contact_person_name")
  contactPersonMobile String?  @map("contact_person_mobile")
  contactPersonEmail  String?  @map("contact_person_email")
  referenceName       String?  @map("reference_name")
  referenceMobile     String?  @map("reference_mobile")
  referenceEmail      String?  @map("reference_email")
  bankName            String?  @map("bank_name")
  bankBranch          String?  @map("bank_branch")
  ifscCode            String?  @map("ifsc_code")
  micrCode            String?  @map("micr_code")
  bankAccountNumber   String?  @map("bank_account_number")
  upiId               String?  @map("upi_id")
  isActive            Boolean  @default(true) @map("is_active")
  isDeleted           Boolean  @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  isDirectClient      Boolean  @default(true) @map("is_direct_client")
  dealerCode          String?  @map("dealer_code")
  openingBalance      Float    @default(0) @map("opening_balance")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  group         Group         @relation(fields: [groupId], references: [id])
  brokerages    Brokerage[]
  trades        Trade[]       @relation("AccountTrades")
  brokerTrades  Trade[]       @relation("BrokerTrades")
  voucherLines  VoucherLine[]
  ledgerEntries Ledger[]

  @@index([name])
  @@index([groupId])
  @@index([isDeleted])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// SCRIPTS
// ─────────────────────────────────────────────

model Script {
  id         String    @id @default(uuid())
  shortName  String    @map("short_name")
  fullName   String    @map("full_name")
  isin       String?   @map("isin")
  lotSize    Int       @map("lot_size")
  exchangeId String?   @map("exchange_id")
  currencyId String?   @map("currency_id")
  isActive   Boolean   @default(true) @map("is_active")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt      @map("updated_at")

  exchange     Exchange?    @relation(fields: [exchangeId], references: [id])
  currency     Currency?    @relation(fields: [currencyId], references: [id])
  brokerages   Brokerage[]
  trades       Trade[]
  closingRates ClosingRate[]

  @@index([shortName])
  @@index([fullName])
  @@index([exchangeId])
  @@index([isDeleted])
  @@map("scripts")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AppliesTo {
  CLIENT
  BROKER
}

enum Direction {
  BOTH
  BUY
  SELL
}

enum BrokerageScope {
  DEFAULT
  SCRIPT
}

// ─────────────────────────────────────────────
// EXCHANGES
// ─────────────────────────────────────────────

model Exchange {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String?
  isActive Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  trades       Trade[]
  closingRates ClosingRate[]
  scripts      Script[]

  @@index([isDeleted])
  @@map("exchanges")
}

// ─────────────────────────────────────────────
// CURRENCIES
// ─────────────────────────────────────────────

model Currency {
  id        String    @id @default(uuid())
  code      String    @unique              // e.g. "USD", "AED", "INR"
  name      String?                        // e.g. "US Dollar"
  symbol    String?                        // e.g. "$", "₹", "د.إ"
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  scripts   Script[]

  @@index([isDeleted])
  @@map("currencies")
}


// ─────────────────────────────────────────────
// TRADES
// ─────────────────────────────────────────────

model Trade {
  id              String   @id @default(uuid())
  tradeNumber     String   @map("trade_number")
  tradeDate       DateTime @map("trade_date")
  tradeTime       String?  @map("trade_time")
  accountId       String   @map("account_id")
  scriptId        String   @map("script_id")
  exchangeId      String   @map("exchange_id")
  transactionType String   @map("transaction_type") // BUY or SELL
  quantity        Float    @map("quantity")
  rate            Float    @map("rate")
  remarks         String?  @map("remarks")
  source          String   @map("source") // MANUAL or IMPORT
  terminal        String?  @map("terminal")
  expiry          String?  @map("expiry")
  orderId         String?  @map("order_id")
  exchangeTime    String?  @map("exchange_time")
  uniqueTradeId   String?  @map("unique_trade_id")
  orderTime       String?  @map("order_time")

  // Additional fields for Dubai FnO & trade imports
  dealerCode      String?  @map("dealer_code")
  currencyCode    String?  @map("currency_code")
  securityName    String?  @map("security_name")
  delMonth        String?  @map("del_month")
  marketLot       Float?   @map("market_lot")
  callPut         String?  @map("call_put")
  strikePrice     Float?   @map("strike_price")
  bloombergCode   String?  @map("bloomberg_code")
  mktValue        Float?   @map("mkt_value")
  clnCommission   Float?   @map("cln_commission")
  clnExCharges    Float?   @map("cln_ex_charges")
  clnCharges1     Float?   @map("cln_charges1")
  clnCharges2     Float?   @map("cln_charges2")
  vat             Float?   @map("vat")

  // Trade classification
  tradeType          String      @default("REGULAR") @map("trade_type") // REGULAR, CARRY_FORWARD, BACK_FORWARD, SETTLEMENT
  settlementId       String?     @map("settlement_id")
  originSettlementId String?     @map("origin_settlement_id")
  isDeleted          Boolean     @default(false) @map("is_deleted")
  deletedAt          DateTime?   @map("deleted_at")

  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt      @map("updated_at")

  // Calculations
  brokerId           String?     @map("broker_id")
  clientRate         Float?      @map("client_rate")
  brokerRate         Float?      @map("broker_rate")
  clientBrokerage    Float?      @map("client_brokerage")
  brokerBrokerage    Float?      @map("broker_brokerage")
  profitTotal        Float?      @map("profit_total")

  account          Account     @relation("AccountTrades", fields: [accountId],  references: [id], onDelete: Cascade)
  broker           Account?    @relation("BrokerTrades",  fields: [brokerId],   references: [id], onDelete: Cascade)
  script           Script      @relation(fields: [scriptId],   references: [id], onDelete: Cascade)
  exchange         Exchange    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  settlement       Settlement? @relation("SettlementTrades", fields: [settlementId], references: [id])
  originSettlement Settlement? @relation("SettlementOriginTrades", fields: [originSettlementId], references: [id])

  @@index([accountId])
  @@index([brokerId])
  @@index([scriptId])
  @@index([exchangeId])
  @@index([settlementId])
  @@index([originSettlementId])
  @@index([tradeDate])
  @@index([settlementId, tradeDate])
  @@index([tradeType])
  @@index([isDeleted])
  @@index([isDeleted, settlementId])
  @@map("trades")
}

// ─────────────────────────────────────────────
// BROKERAGES
// ─────────────────────────────────────────────

model Brokerage {
  id          String         @id @default(uuid())
  accountId   String         @map("account_id")
  appliesTo   AppliesTo      @map("applies_to")
  scope       BrokerageScope @default(DEFAULT)
  scriptId    String?        @map("script_id")
  direction   Direction      @default(BOTH) @map("direction")

  // Quantity-based brokerage
  quantity    Float          @map("quantity")
  brokerage   Float          @map("brokerage")

  isDeleted   Boolean        @default(false) @map("is_deleted")
  deletedAt   DateTime?      @map("deleted_at")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  account  Account  @relation(fields: [accountId],  references: [id], onDelete: Cascade)
  script   Script?  @relation(fields: [scriptId],   references: [id], onDelete: Cascade)

  @@unique([accountId, appliesTo, scope, scriptId, direction], name: "uq_brokerage_rule")
  @@index([accountId])
  @@index([scriptId])
  @@index([isDeleted])
  @@map("brokerages")
}

// ─────────────────────────────────────────────
// CLOSING RATES
// ─────────────────────────────────────────────

model ClosingRate {
  id            String    @id @default(uuid())
  exchangeId    String    @map("exchange_id")
  scriptId      String?   @map("script_id")
  securityName  String    @map("security_name")
  rateDate      DateTime  @map("rate_date")
  rate          Float     @map("rate")

  expiry        String?   @map("expiry")
  delMonth      String?   @map("del_month")
  callPut       String?   @map("call_put")
  strikePrice   Float?    @map("strike_price")
  bloombergCode String?   @map("bloomberg_code")
  currencyCode  String?   @map("currency_code")

  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  script   Script?  @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, securityName, rateDate])
  @@index([exchangeId])
  @@index([scriptId])
  @@index([securityName])
  @@index([rateDate])
  @@index([rateDate, securityName])
  @@index([isDeleted])
  @@map("closing_rates")
}

// ─────────────────────────────────────────────
// SETTLEMENTS
// ─────────────────────────────────────────────

model Settlement {
  id        String    @id @default(uuid())
  name      String                          // e.g. "Settlement 1"
  fromDate  DateTime  @map("from_date")
  toDate    DateTime  @map("to_date")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  trades        Trade[]  @relation("SettlementTrades")
  originTrades  Trade[]  @relation("SettlementOriginTrades")
  ledgerEntries Ledger[]

  @@index([isDeleted])
  @@map("settlements")
}

// ─────────────────────────────────────────────
// LEDGER ENTRIES
// ─────────────────────────────────────────────

model Ledger {
  id           String      @id @default(uuid())
  accountId    String      @map("account_id")
  settlementId String?     @map("settlement_id")
  date         DateTime    @map("date")
  amount       Float       @map("amount")
  entryType    String      @map("entry_type")       // SETTLEMENT, VOUCHER
  description  String?     @map("description")
  referenceId  String?     @map("reference_id")     // settlementId or voucherId
  isDeleted    Boolean     @default(false) @map("is_deleted")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt      @map("updated_at")

  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([settlementId])
  @@index([entryType])
  @@index([referenceId])
  @@index([date])
  @@index([accountId, date])
  @@index([isDeleted])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────
// VOUCHERS
// ─────────────────────────────────────────────

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
}

model Voucher {
  id            String        @id @default(uuid())
  voucherNumber String?       @map("voucher_number")
  date          DateTime      @map("date")
  type          VoucherType   @map("type")
  remarks       String?       @map("remarks")
  isDeleted     Boolean       @default(false) @map("is_deleted")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt      @map("updated_at")
  
  lines         VoucherLine[]

  @@index([isDeleted])
  @@map("vouchers")
}

model VoucherLine {
  id        String    @id @default(uuid())
  voucherId String    @map("voucher_id")
  accountId String    @map("account_id")
  amount    Float     @map("amount")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([accountId])
  @@index([isDeleted])
  @@map("voucher_lines")
}

// ─────────────────────────────────────────────
// EXPIRY DATES
// ─────────────────────────────────────────────

model ExpiryDate {
  id             String    @id @default(uuid())
  date           String    @unique
  normalizedDate DateTime  @map("normalized_date")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt      @map("updated_at")

  @@index([normalizedDate])
  @@index([isDeleted])
  @@map("expiry_dates")
}


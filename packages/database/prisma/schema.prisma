generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String?
  roleId    String?  @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  role Role? @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]

  @@map("roles")
}

// ─────────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────────

model Group {
  id   Int    @id @default(autoincrement())
  name String @unique
  fldNo Int?

  accounts Account[]

  @@map("groups")
}

// ─────────────────────────────────────────────
// ACCOUNTS (Client + Broker + Ledger)
// ─────────────────────────────────────────────

model Account {
  id               String   @id @default(uuid())

  code             String?
  name             String
  fldAOD           String?
  fldType          String?

  groupId          Int?     @map("group_id")
  fldGroupBusiness String?
  fldGroupFamily   String?

  opening          Float?
  debit            Float?
  credit           Float?
  closing          Float?

  address          String?
  mobileNumber     String?  @map("mobile_number")
  officeNumber     String?  @map("office_number")
  whatsappNumber   String?  @map("whatsapp_number")
  email            String?

  contactPersonName  String? @map("contact_person_name")
  contactPersonMobile String? @map("contact_person_mobile")
  contactPersonEmail  String? @map("contact_person_email")

  defaultCredit    Float?   @map("default_credit")
  interest         Float?   @map("interest")

  bankName         String?  @map("bank_name")
  bankBranch       String?  @map("bank_branch")
  ifscCode         String?  @map("ifsc_code")
  accountNumber    String?  @map("bank_account_number")
  upiId            String?  @map("upi_id")

  referenceMobile  String?  @map("reference_mobile")
  referenceEmail   String?  @map("reference_email")

  fldClientID      String?
  fldDPID          String?

  fldServiceTax    Boolean?  @default(false)
  fldTurnOverTax   Boolean?  @default(false)
  fldStampDuty     Boolean?  @default(false)
  fldDematCharge   Boolean?  @default(false)
  fldPrintBill     Boolean?  @default(false)

  fldTeleDir       String?
  fldAddBook       String?

  fldTranCharge    Float?
  fldMrgnAmt       Float?
  fldExposure      Float?
  fldShare         Float?

  fldPAN           String?
  fldMICR          String?
  fldBankAccNo     String?

  fldTB            String?
  fldL             String?
  fldPT            String?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  group Group? @relation(fields: [groupId], references: [id])

  brokerages Brokerage[]

  @@index([name])
  @@index([groupId])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// SCRIPTS
// ─────────────────────────────────────────────

model Script {
  id               String   @id @default(uuid())

  fldShortScript   String?
  fldScriptName    String

  fldScriptASE     String?
  fldScriptBSE     String?
  fldScriptNSE     String?
  fldScriptNMC     String?
  fldScriptNCD     String?
  fldScriptMCX     String?
  fldScriptICE     String?

  fldType          String?
  fldISIN          String?

  fldMargin        Float?
  fldMultiplier    Float?
  fldPrice         Float?
  fldDivider       Float?

  fldUoQ           String?
  fldPU            String?
  fldDC            String?

  fldScriptACE     String?
  fldScriptUSE     String?
  fldScriptDGC     String?
  fldScriptACX     String?
  fldScriptUCX     String?

  fldLotSize       Int?
  fldTP            Float?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  @@index([fldScriptName])
  @@map("scripts")

  brokerages Brokerage[]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AppliesTo {
  CLIENT
  BROKER
}

enum BrokerageType {
  AMOUNT
  PERCENT
}

enum BrokerageScope {
  DEFAULT
  SCRIPT
}

// ─────────────────────────────────────────────
// EXCHANGES
// ─────────────────────────────────────────────

model Exchange {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  brokerages Brokerage[]

  @@map("exchanges")
}

// ─────────────────────────────────────────────
// BROKERAGES
// ─────────────────────────────────────────────

model Brokerage {
  id          String         @id @default(uuid())
  accountId   String         @map("account_id")
  exchangeId  String         @map("exchange_id")
  appliesTo   AppliesTo      @map("applies_to")
  type        BrokerageType
  scope       BrokerageScope @default(DEFAULT)
  scriptId    String?        @map("script_id")

  // Amount-based fields
  baseAmount  Float?         @map("base_amount")
  flatFee     Float?         @map("flat_fee")

  // Trading percentage fields
  tradingBuyPct   Float?     @map("trading_buy_pct")
  tradingSellPct  Float?     @map("trading_sell_pct")
  tradingMinFee   Float?     @map("trading_min_fee")

  // Delivery percentage fields
  deliveryBuyPct  Float?     @map("delivery_buy_pct")
  deliverySellPct Float?     @map("delivery_sell_pct")
  deliveryMinFee  Float?     @map("delivery_min_fee")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  account  Account  @relation(fields: [accountId],  references: [id])
  exchange Exchange @relation(fields: [exchangeId], references: [id])
  script   Script?  @relation(fields: [scriptId],   references: [id])

  @@unique([accountId, exchangeId, appliesTo, scope, scriptId], name: "uq_brokerage_rule")
  @@index([accountId])
  @@index([exchangeId])
  @@map("brokerages")
}

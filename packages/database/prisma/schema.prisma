generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  roleId    String

  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]
}

model Group {
  id   String  @id @default(uuid())
  name String  @unique

  accounts Account[]
}

model Account {
  id        String   @id @default(uuid())
  name      String
  groupId   String

  address   String?
  phone     String?
  email     String?

  openingBalance Float?

  // Broker fields
  pan        String?
  dpId       String?

  // Client fields
  brokerageDefault Float?

  reference      String?
  contactPerson  String?

  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  brokerage ClientBrokerage[]
}

model Script {
  id          String  @id
  fullName    String
  exchange    String?
  lotSize     Int?
  tickPrice   Float?
  multiplier  Float?
  closingRate Float?

  brokerages  ClientBrokerage[]
}

model ClientBrokerage {
  id        String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  exchange  String
  scriptId  String?

  brokerageType String
  value         Float
  minValue      Float?

  createdAt DateTime @default(now())

  script Script? @relation(fields: [scriptId], references: [id])
}

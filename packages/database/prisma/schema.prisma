generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String?
  roleId    String?  @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  role Role? @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]

  @@map("roles")
}

// ─────────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────────

model Group {
  fldGroupNo   Int     @id @default(autoincrement())
  fldGroupName String  @unique
  fldNo        Int?

  accounts Account[]

  @@map("groups")
}

// ─────────────────────────────────────────────
// ACCOUNTS (Client + Broker + Ledger)
// ─────────────────────────────────────────────

model Account {
  id               String   @id @default(uuid())

  fldClient        String?
  fldName          String
  fldAOD           String?
  fldType          String?

  fldGroupNo       Int?
  fldGroupBusiness String?
  fldGroupFamily   String?

  fldOpening       Float?
  fldDebit         Float?
  fldCredit        Float?
  fldClosing       Float?

  fldAddress       String?
  fldPhoneH        String?
  fldPhoneO1       String?
  fldPhoneO2       String?
  fldMobile        String?
  fldEmail         String?
  fldReference     String?

  fldClientID      String?
  fldDPID          String?

  fldServiceTax    Boolean?  @default(false)
  fldTurnOverTax   Boolean?  @default(false)
  fldStampDuty     Boolean?  @default(false)
  fldDematCharge   Boolean?  @default(false)
  fldPrintBill     Boolean?  @default(false)

  fldTeleDir       String?
  fldAddBook       String?

  fldTranCharge    Float?
  fldMrgnAmt       Float?
  fldExposure      Float?
  fldShare         Float?

  fldPAN           String?
  fldMICR          String?
  fldBankAccNo     String?

  fldTB            String?
  fldL             String?
  fldPT            String?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  group Group? @relation(fields: [fldGroupNo], references: [fldGroupNo])

  @@index([fldName])
  @@index([fldGroupNo])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// SCRIPTS
// ─────────────────────────────────────────────

model Script {
  id               String   @id @default(uuid())

  fldShortScript   String?
  fldScriptName    String

  fldScriptASE     String?
  fldScriptBSE     String?
  fldScriptNSE     String?
  fldScriptNMC     String?
  fldScriptNCD     String?
  fldScriptMCX     String?
  fldScriptICE     String?

  fldType          String?
  fldISIN          String?

  fldMargin        Float?
  fldMultiplier    Float?
  fldPrice         Float?
  fldDivider       Float?

  fldUoQ           String?
  fldPU            String?
  fldDC            String?

  fldScriptACE     String?
  fldScriptUSE     String?
  fldScriptDGC     String?
  fldScriptACX     String?
  fldScriptUCX     String?

  fldLotSize       Int?
  fldTP            Float?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  @@index([fldScriptName])
  @@map("scripts")
}

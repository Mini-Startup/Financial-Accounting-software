generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  roleId    String   @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]
}

model Group {
  id   String  @id @default(uuid())
  name String  @unique

  accounts Account[]
}

model Account {
  id              String   @id @default(uuid())
  code            String?  @unique
  name            String
  groupId         String   @map("group_id")

  address         String?
  email           String?
  reference       String?

  phoneHome       String?  @map("phone_home")
  phoneOffice1    String?  @map("phone_office_1")
  phoneOffice2    String?  @map("phone_office_2")
  mobile          String?

  // identity
  dpId            String?  @map("dp_id")
  clientId        String?  @map("client_id")
  micr            String?
  accountNo       String?  @map("account_no")
  pan             String?

  // flags
  printBill          Boolean? @map("print_bill")
  serviceTax         Boolean? @map("service_tax")
  turnoverTax        Boolean? @map("turnover_tax")
  stampDuty          Boolean? @map("stamp_duty")
  dematCharge        Boolean? @map("demat_charge")
  transactionCharges Boolean? @map("transaction_charges")

  // financial
  openingBalance  Float?   @map("opening_balance")
  closingBalance  Float?   @map("closing_balance")

  // script-related
  shortName        String? @map("short_name")
  fullName         String? @map("full_name")
  isin             String?
  aseCode         String? @map("ase_code")
  bseCode         String? @map("bse_code")
  nseCode         String? @map("nse_code")
  mcxCode         String? @map("mcx_code")
  ncdexCode       String? @map("ncdex_code")

  multiplier       Float?
  divider          Float?
  lotSize          Int?    @map("lot_size")
  tickPrice        Float?  @map("tick_price")
  fixMarginPercent Float?  @map("fix_margin_percent")
  lastClosingRate  Float?  @map("last_closing_rate")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id])

  @@index([name])
  @@index([groupId])
  @@map("accounts")
}
